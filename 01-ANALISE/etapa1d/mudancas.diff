diff --git a/input/drivers/android_input.c b/input/drivers/android_input.c
index 6246767..8de3066 100644
--- a/input/drivers/android_input.c
+++ b/input/drivers/android_input.c
@@ -1995,6 +1995,39 @@ static INLINE void android_input_poll_event_type_key(int port,
    int action  = key->action;
    int keycode = key->keycode;
 
+   /* MOD: Voltar do sistema (botao ou gesto) abre o menu rapido do jogo.
+    * Cada tecla chega duas vezes (e uma vez por funcao que le o evento);
+    * event_time evita abrir e fechar na mesma tecla. */
+   if (     keycode == AKEYCODE_BACK
+         && action  == AKEY_EVENT_ACTION_DOWN
+         && (key->source & AINPUT_SOURCE_GAMEPAD)  != AINPUT_SOURCE_GAMEPAD
+         && (key->source & AINPUT_SOURCE_JOYSTICK) != AINPUT_SOURCE_JOYSTICK)
+   {
+      static int64_t mod_ultimo_voltar = -1;
+      if ((int64_t)key->event_time != mod_ultimo_voltar)
+      {
+         char mod_dbg[96];
+         int  mod_n = snprintf(mod_dbg, sizeof(mod_dbg),
+               "DIAG Voltar: fonte=0x%x jogo=%d menu=%d",
+               (unsigned)key->source,
+               (runloop_get_flags() & RUNLOOP_FLAG_CORE_RUNNING) ? 1 : 0,
+               (menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE) ? 1 : 0);
+         runloop_msg_queue_push(mod_dbg, (size_t)mod_n, 1, 120, true, NULL,
+               MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+      }
+      if ((int64_t)key->event_time != mod_ultimo_voltar)
+      {
+         mod_ultimo_voltar = (int64_t)key->event_time;
+         if (   (runloop_get_flags() & RUNLOOP_FLAG_CORE_RUNNING)
+             && !(menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE))
+         {
+            command_event(CMD_EVENT_MENU_TOGGLE, NULL);
+            *handled = 1;
+            return;
+         }
+      }
+   }
+
    /* android_key_state[] has one row per pad slot plus the
     * dedicated keyboard row at ANDROID_KEYBOARD_PORT. */
    if (port < 0 || port > ANDROID_KEYBOARD_PORT)
diff --git a/input/input_driver.c b/input/input_driver.c
