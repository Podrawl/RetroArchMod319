+/* Chamado pelo desenho dos widgets: devolve quantos botoes ha (0 = editor fechado). */
+int input_overlay_editor_ui(int *r, const char **lab, int max)
+{
+   static const char *nomes[12] =
+      { "Altura -", "Altura +", "Largura -", "Largura +", "Fechar",
+        "Pag <", "Pag >", NULL, "Centralizar", "Original",
+        "Salvar novo", "Sobrescrever" };
+   int k, n;
+   if (!mod_editor_active || mod_editor_wait_close || mod_ui_timer <= 0 || max < 12)
+      return 0;
+   n = mod_ui_rects(r);
+   for (k = 0; k < n; k++)
+      lab[k] = nomes[k];
+   {
+      input_overlay_t *ol = input_driver_st.overlay_ptr;
+      if (ol && ol->active)
+         snprintf(mod_ui_title, sizeof(mod_ui_title), "%s%s (%u de %u)",
+               ((unsigned)ol->index == (unsigned)mod_main_page) ? "* " : "",
+               ol->active->name, (unsigned)ol->index + 1, (unsigned)ol->size);
+      else
+         snprintf(mod_ui_title, sizeof(mod_ui_title), "?");
+      lab[7] = mod_ui_title;
+   }
+   return n;
+}
+
+static int mod_ui_hit(float px, float py)
+{
+   int r[48];
+   int k, n;
+   if (mod_ui_timer <= 0)
+      return -1;
+   n = mod_ui_rects(r);
+   for (k = 0; k < n; k++)
+      if (   px >= (float)r[k * 4 + 0] && px < (float)(r[k * 4 + 0] + r[k * 4 + 2])
+          && py >= (float)r[k * 4 + 1] && py < (float)(r[k * 4 + 1] + r[k * 4 + 3]))
+         return k;
+   return -1;
+}
+
+/* Vai para a pagina anterior/proxima (pula as de nome "hidden..."). */
+static void mod_page_goto(int dir)
+{
+   input_overlay_t *ol = input_driver_st.overlay_ptr;
+   size_t   tries;
+   unsigned idx;
+   bool     tmp = false;
+   if (!ol || ol->size < 2)
+      return;
+   idx = (unsigned)ol->index;
+   for (tries = 0; tries < ol->size; tries++)
+   {
+      idx = (unsigned)((idx + (dir > 0 ? 1 : ol->size - 1)) % ol->size);
+      if (strncmp(ol->overlays[idx].name, "hidden", 6) != 0)
+         break;
+   }
+   if (idx == (unsigned)ol->index
+         || strncmp(ol->overlays[idx].name, "hidden", 6) == 0)
+      return;
+   ol->next_index   = idx;
+   command_event(CMD_EVENT_OVERLAY_NEXT, &tmp);
+   mod_editor_sel   = -1;
+   mod_grp_n        = 0;
+}
+
+static void mod_ui_press(int b)
+{
+   int x, y, w, h;
+   if (b == 4)
+   {
+      static const char msg[] = "Editor de overlay encerrado.";
+      mod_editor_active = false;
+      mod_editor_sel    = -1;
+      mod_editor_pinch  = false;
+      command_event(CMD_EVENT_UNPAUSE, NULL);
+      runloop_msg_queue_push(msg, sizeof(msg) - 1, 1, 120, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+      return;
+   }
+   if (b == 7)
+   {
+      input_overlay_t *ol = input_driver_st.overlay_ptr;
+      if (ol)
+         mod_main_page = (int)ol->index;
+      return;
+   }
+   if (b == 5 || b == 6)
+   {
+      mod_page_goto(b == 6 ? 1 : -1);
+      return;
+   }
+   if (b == 10 || b == 11)
+   {
+      mod_save_cfg(b == 11);
+      return;
+   }
+   mod_vp_get(&x, &y, &w, &h);
+   switch (b)
+   {
+      /* x,y sao deslocamento da ancora (centro): ao mudar w/h a imagem ja cresce
+       * para os dois lados sozinha, entao x,y NAO mudam. */
+      case 0: h -= 4; break;
+      case 1: h += 4; break;
+      case 2: w -= 4; break;
+      case 3: w += 4; break;
+      case 8: x = 0; y = 0; break;
+      case 9:
+      {
+         /* proporcao original do jogo (a do nucleo), a maior que cabe na tela, centralizada */
+         video_driver_state_t *vs = video_state_get_ptr();
+         float asp = vs->av_info.geometry.aspect_ratio;
+         if (asp <= 0.0f && vs->av_info.geometry.base_height)
+            asp = (float)vs->av_info.geometry.base_width
+                / (float)vs->av_info.geometry.base_height;
+         if (asp <= 0.0f || mod_win_w <= 0 || mod_win_h <= 0)
+            return;
+         w = mod_win_w;
+         h = (int)((float)w / asp);
+         if (h > mod_win_h)
+         {
+            h = mod_win_h;
+            w = (int)((float)h * asp);
+         }
+         x = 0;
+         y = 0;
+         break;
+      }
+      default: return;
+   }
+   mod_vp_set(x, y, w, h);
+}
+
+/* Uma vez por leitura de toques; count = dedos na tela. */
+static void mod_editor_frame(input_overlay_t *ol, int count,
+      const input_overlay_state_t *st)
+{
+   int kk;
+   bool menu_alive = (menu_state_get_ptr()->flags & MENU_ST_FLAG_ALIVE) != 0;
+
+   for (kk = 0; kk < 2 && kk < count; kk++)
+   {
+      mod_raw_x[kk] = (float)VIDEO_POS_X(st->touch[kk]);
+      mod_raw_y[kk] = (float)VIDEO_POS_Y(st->touch[kk]);
+   }
+   if (count > 0)
+      mod_ui_timer = 300;
+   else if (mod_ui_timer > 0)
+      mod_ui_timer--;
+   {
+      struct video_viewport vp2;
+      memset(&vp2, 0, sizeof(vp2));
+      if (video_driver_get_viewport_info(&vp2))
+      {
+         mod_win_w = (int)VIDEO_SCALE_W(vp2.full_dims);
+         mod_win_h = (int)VIDEO_SCALE_H(vp2.full_dims);
+      }
+   }
+
+   /* So considera "menu aberto" depois de ter visto o menu fechado uma vez */
+   if (mod_editor_wait_close)
+   {
+      if (!menu_alive)
+      {
+         mod_editor_wait_close = false;
+         mod_editor_seed_screen();
+         mod_ui_timer = 300;
+         mod_snap_take(input_driver_st.overlay_ptr);
+      }
+   }
+   else if (menu_alive)
+   {
+      mod_editor_active = false;
+      return;
+   }
+
+   mod_editor_fingers = count;
+   if (count == 0)
+   {
+      mod_editor_sel    = -1;
+      mod_editor_pinch  = false;
+      mod_editor_screen = false;
+      mod_ui_held       = -1;
+      mod_grp_n         = 0;
+   }
+   else if (count >= 3)
+   {
+      static const char msg[] = "Editor de overlay encerrado.";
+      mod_editor_active = false;
+      mod_editor_sel    = -1;
+      mod_editor_pinch  = false;
+      command_event(CMD_EVENT_UNPAUSE, NULL);
+      runloop_msg_queue_push(msg, sizeof(msg) - 1, 1, 120, true, NULL,
+            MESSAGE_QUEUE_ICON_DEFAULT, MESSAGE_QUEUE_CATEGORY_INFO);
+   }
+}
+
+static bool mod_mask_empty(const struct overlay_desc *d)
+{
+   size_t k;
+   for (k = 0; k < ARRAY_SIZE(d->button_mask.data); k++)
+      if (d->button_mask.data[k])
+         return false;
+   return true;
+}
+
+/* Botao so de direcao (cima/baixo/esquerda/direita e diagonais) ou area de dpad */
+static bool mod_is_dir(const struct overlay_desc *d)
+{
+   unsigned k;
+   bool any = false;
+   if (d->type == OVERLAY_TYPE_DPAD_AREA)
+      return true;
+   if (d->type != OVERLAY_TYPE_BUTTONS)
+      return false;
+   for (k = 0; k < 256; k++)
+   {
+      if (!BIT256_GET(d->button_mask, k))
+         continue;
+      if (   k == RETRO_DEVICE_ID_JOYPAD_UP   || k == RETRO_DEVICE_ID_JOYPAD_DOWN
+          || k == RETRO_DEVICE_ID_JOYPAD_LEFT || k == RETRO_DEVICE_ID_JOYPAD_RIGHT)
+         any = true;
+      else
+         return false;
+   }
+   return any;
+}
+
+static bool mod_is_analog(const struct overlay_desc *d)
+{
+   return d->type == OVERLAY_TYPE_ANALOG_LEFT
+       || d->type == OVERLAY_TYPE_ANALOG_RIGHT;
+}
+
+static bool mod_is_nul(const struct overlay_desc *d)
+{
+   return d->type == OVERLAY_TYPE_BUTTONS && mod_mask_empty(d);
+}
+
+/* Dois botoes vizinhos (encostados ou quase) */
+static bool mod_adj(const struct overlay_desc *a, const struct overlay_desc *b)
+{
+   float dx = a->x - b->x, dy = a->y - b->y;
+   if (dx < 0.0f) dx = -dx;
+   if (dy < 0.0f) dy = -dy;
+   return dx <= (a->range_x + b->range_x) * 1.6f
+       && dy <= (a->range_y + b->range_y) * 1.6f;
+}
+
+static void mod_grp_add(int i)
+{
+   int k;
+   for (k = 0; k < mod_grp_n; k++)
+      if (mod_grp[k] == i)
+         return;
+   if (mod_grp_n < MOD_MAX_GRP)
+      mod_grp[mod_grp_n++] = i;
+}
+
+/* Monta o grupo do botao tocado t. */
+static void mod_build_group(struct overlay *pg, int t)
+{
+   struct overlay_desc *descs = pg->descs;
+   int n = (int)pg->size;
+   int i, seed = -1;
+
+   mod_grp_n = 0;
+
+   /* analogico: ele mais os "nul" no mesmo lugar (a imagem do circulo) */
+   {
+      int anchor = -1;
+      if (mod_is_analog(&descs[t]))
+         anchor = t;
+      else if (mod_is_nul(&descs[t]))
+         for (i = 0; i < n; i++)
+            if (mod_is_analog(&descs[i]))
+            {
+               float dx = descs[t].x - descs[i].x, dy = descs[t].y - descs[i].y;
+               if (dx < 0.0f) dx = -dx;
+               if (dy < 0.0f) dy = -dy;
+               if (dx <= 0.5f * descs[i].range_x && dy <= 0.5f * descs[i].range_y)
+               {
+                  anchor = i;
+                  break;
+               }
+            }
+      if (anchor >= 0)
+      {
+         mod_grp_add(anchor);
+         for (i = 0; i < n; i++)
+         {
+            float dx, dy;
+            if (i == anchor || !mod_is_nul(&descs[i]))
+               continue;
+            dx = descs[i].x - descs[anchor].x;
+            dy = descs[i].y - descs[anchor].y;
+            if (dx < 0.0f) dx = -dx;
+            if (dy < 0.0f) dy = -dy;
+            if (dx <= 0.5f * descs[anchor].range_x && dy <= 0.5f * descs[anchor].range_y)
+               mod_grp_add(i);
+         }
+         return;
+      }
+   }
+
+   /* direcional: todos os botoes de direcao ligados entre si + "nul" do centro */
+   if (mod_is_dir(&descs[t]))
+      seed = t;
+   else if (mod_is_nul(&descs[t]))
+      for (i = 0; i < n; i++)
+         if (mod_is_dir(&descs[i]) && mod_adj(&descs[t], &descs[i]))
+         {
+            seed = i;
+            break;
+         }
+
+   if (seed >= 0)
+   {
+      int k;
+      mod_grp_add(seed);
+      for (k = 0; k < mod_grp_n; k++)       /* varre ampliando o grupo */
+         for (i = 0; i < n; i++)
+            if (mod_is_dir(&descs[i]) && mod_adj(&descs[mod_grp[k]], &descs[i]))
+               mod_grp_add(i);
+      {
+         int dirs = mod_grp_n;
+         for (i = 0; i < n; i++)
+            if (mod_is_nul(&descs[i]))
+               for (k = 0; k < dirs; k++)
+                  if (mod_adj(&descs[mod_grp[k]], &descs[i]))
+                  {
+                     mod_grp_add(i);
+                     break;
+                  }
+      }
+      return;
+   }
+
+   mod_grp_add(t);
+}
+
+/* Um dedo (idx) em (x,y), no mesmo espaco dos botoes (x_shift/y_shift). */
+static void mod_editor_touch(input_overlay_t *ol, int idx, float x, float y)
+{
+   struct overlay_desc *descs = ol->active->descs;
+
+   if (idx == 0)
+   {
+      mod_editor_x0 = x;
+      mod_editor_y0 = y;
+
+      if (mod_editor_sel < 0 && !mod_editor_screen)
+      {
+         float upx, upy;
+         int   ub;
+         mod_scr_finger(0, &upx, &upy);
+         ub = mod_ui_hit(upx, upy);
+         if (ub >= 0 && (mod_ui_held < 0 || mod_ui_held == ub))
+         {
+            if (mod_ui_held != ub)
+            {
+               mod_ui_held   = ub;
+               mod_ui_hold_n = 0;
+               mod_ui_press(ub);
+            }
+            else
+            {
+               mod_ui_hold_n++;
+               if ((ub < 4) && mod_ui_hold_n > 24 && (mod_ui_hold_n % 4) == 0)
+                  mod_ui_press(ub);
+            }
+            return;
+         }
+         if (mod_ui_held >= 0)
+            return;
+      }
+
+      if (mod_editor_sel < 0 && !mod_editor_screen)
+      {
+         size_t i;
+         float  best = 1e9f;
+         for (i = 0; i < ol->active->size; i++)
+         {
+            struct overlay_desc *d = &descs[i];
+            float area = d->range_x * d->range_y;
+            if (area <= 0.0f)
+               continue;
+            if (!input_overlay_coords_inside_hitbox(d, x, y, false))
+               continue;
+            if (area < best)
+            {
+               best                = area;
+               mod_editor_sel      = (int)i;
+               mod_editor_grab_dx  = x - d->x_shift;
+               mod_editor_grab_dy  = y - d->y_shift;
+            }
+         }
+         if (mod_editor_sel >= 0)
+            mod_build_group(ol->active, mod_editor_sel);
+         else
+            mod_screen_begin();
+      }
+      else if (mod_editor_screen)
+      {
+         if (mod_editor_fingers < 2)
+            mod_screen_move();
+      }
+      else if (mod_editor_fingers < 2)
+      {
+         struct overlay_desc *t = &descs[mod_editor_sel];
+         float ddx = (x - mod_editor_grab_dx) - t->x_shift;
+         float ddy = (y - mod_editor_grab_dy) - t->y_shift;
+         int k;
+         for (k = 0; k < mod_grp_n; k++)
+         {
+            descs[mod_grp[k]].x += ddx;
+            descs[mod_grp[k]].y += ddy;
+         }
+         mod_editor_apply(ol);
+      }
+   }
+   else if (idx == 1 && mod_editor_screen)
+   {
+      /* tamanho da tela: pelos botoes do editor */
+   }
+   else if (idx == 1 && mod_editor_sel >= 0)
+   {
+      float dx = x - mod_editor_x0;
+      float dy = y - mod_editor_y0;
+      float dist = sqrtf(dx * dx + dy * dy);
+      int k;
+
+      if (!mod_editor_pinch)
+      {
+         float minx = 1e9f, maxx = -1e9f, miny = 1e9f, maxy = -1e9f;
+         mod_editor_pinch    = true;
+         mod_editor_pinch_d0 = (dist > 0.01f) ? dist : 0.01f;
+         for (k = 0; k < mod_grp_n; k++)
+         {
+            struct overlay_desc *d = &descs[mod_grp[k]];
+            mod_grp_x0[k]  = d->x;
+            mod_grp_y0[k]  = d->y;
+            mod_grp_rx0[k] = d->range_x;
+            mod_grp_ry0[k] = d->range_y;
+            if (d->x < minx) minx = d->x;
+            if (d->x > maxx) maxx = d->x;
+            if (d->y < miny) miny = d->y;
+            if (d->y > maxy) maxy = d->y;
+         }
+         mod_grp_px = 0.5f * (minx + maxx);
+         mod_grp_py = 0.5f * (miny + maxy);
+      }
+      else
+      {
+         float f = dist / mod_editor_pinch_d0;
+         if (f < 0.3f) f = 0.3f;
+         if (f > 3.0f) f = 3.0f;
+         for (k = 0; k < mod_grp_n; k++)
+         {
+            struct overlay_desc *d = &descs[mod_grp[k]];
+            d->x       = mod_grp_px + (mod_grp_x0[k] - mod_grp_px) * f;
+            d->y       = mod_grp_py + (mod_grp_y0[k] - mod_grp_py) * f;
+            d->range_x = mod_grp_rx0[k] * f;
+            d->range_y = mod_grp_ry0[k] * f;
+         }
+         mod_editor_apply(ol);
+      }
+   }
+}
